# ---- Server ----
ENVIRONMENT=development          # development | production | test
LOG_LEVEL=INFO
BACKEND_HOST=127.0.0.1           # use 0.0.0.0 inside Docker
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Security ----
RATE_LIMIT_PER_MINUTE=30         # per client IP on POST /api/detect/*; 0 disables
# Only set true behind a reverse proxy you control (e.g. nginx). The LAST
# X-Forwarded-For entry (added by that proxy) is then used as the client IP.
TRUST_PROXY_HEADERS=false

# ---- Upload limits ----
MAX_IMAGE_SIZE_MB=10
MAX_VIDEO_SIZE_MB=100
MAX_IMAGE_PIXELS=40000000        # decompression-bomb guard
MAX_VIDEO_PIXELS=8294400         # 3840x2160
MAX_VIDEO_DURATION_SEC=60
MAX_VIDEO_FRAMES_ANALYZED=24
# TEMP_DIR=                      # default: <system temp>/truthlens-uploads

# ---- Detector ----
DETECTOR_BACKEND=demo            # demo | torch | ensemble (only demo exists so far)
MODEL_PATH=
MODEL_META_PATH=
DEVICE=auto                      # auto | cpu | cuda
UNCERTAIN_BAND_LOW=0.35
UNCERTAIN_BAND_HIGH=0.65
REQUEST_TIMEOUT_SEC=30           # max time waiting for one analysis
MAX_CONCURRENT_ANALYSES=2        # worker threads running inference
RESULT_TTL_SECONDS=900           # how long GET /api/results/{id} works
RESULT_STORE_MAX_ENTRIES=200